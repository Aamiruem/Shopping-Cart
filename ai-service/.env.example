# URL of the Arvixa backend API (used to load products and act on carts)
BACKEND_URL=http://localhost:5000

# Claude: LLM answers in RAG, the shopping assistant, free-form data-analyst questions and the listing writer.
# Without it, RAG returns the best matching passages, the analyst answers from built-in query templates and
# the shopping assistant is disabled.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# PostgreSQL: the SAME database and PG_SCHEMA as backend/.env. The AI service only ever reads the read-only
# reporting views in "<PG_SCHEMA>_analytics", which the backend creates at startup. Without it, the data
# analyst, statistics and forecast endpoints return 503; everything else still works.
DATABASE_URL=
PG_SCHEMA=

# Must equal JWT_SECRET in backend/.env: the AI service checks the same login tokens
JWT_SECRET=dev-secret

# Optional limits for the data analyst's queries
# ANALYST_QUERY_TIMEOUT_MS=5000
# ANALYST_MAX_ROWS=500

# Public storefront address: relative product photo URLs are read from it for photo search
STOREFRONT_URL=http://localhost:5173
# Set to 0 on small machines to keep deep models out of memory (needs requirements-ml.txt when on)
DEEP_MODELS=1
# MLflow tracking server, e.g. http://mlflow:5000 (unset = no experiment tracking)
MLFLOW_TRACKING_URI=
