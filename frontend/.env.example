# Leave empty in dev (Vite proxies /api). Set to the API URL for production builds.
VITE_API_URL=

# preview = browse-only store with sample prices (cart, accounts and checkout off, no prices sent to Google).
# store = accounts, cart, wishlist and cash-on-delivery orders on the api/ functions, with sample ratings and discounts
# still hidden. Vercel builds default to this.
# live = everything on: needs the full API with its databases.
VITE_STORE_MODE=

# Public store address for canonical links and the sitemap, e.g. https://www.yourstore.in
# Optional on Vercel: the project's production domain is used.
VITE_SITE_URL=

# Google Analytics 4 measurement ID, like G-XXXXXXXXXX (Analytics -> Admin -> Data streams)
VITE_GA_MEASUREMENT_ID=

# Search Console and Bing ownership: only the content="..." value of their HTML tag
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Real support email, shown in the footer and legal pages (hidden until set)
VITE_CONTACT_EMAIL=
