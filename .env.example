# Used by docker-compose.yml - copy to .env and fill in
JWT_SECRET=change-me
# Optional: enables AI answers (RAG) and the shopping assistant agent
ANTHROPIC_API_KEY=
# Optional: Google sign-in and real OTP emails (see backend/.env.example)
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: real online payments (UPI, net banking, cards, wallets) - see backend/.env.example
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: SMS / WhatsApp OTP (Twilio) and encryption key - see backend/.env.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
DATA_ENCRYPTION_KEY=
