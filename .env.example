# Used by docker-compose.yml - copy to .env and fill in
JWT_SECRET=change-me
# Optional: enables AI answers (RAG) and the shopping assistant agent
ANTHROPIC_API_KEY=
# Optional: Google sign-in and real OTP emails (see backend/.env.example)
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: real online payments (UPI, net banking, cards, wallets) - see backend/.env.example
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: SMS / WhatsApp OTP (Twilio) and encryption key - see backend/.env.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
DATA_ENCRYPTION_KEY=

# ---------- Verification codes on the Vercel store (api/_otp.mjs) ----------
# Set these in Vercel -> Project -> Settings -> Environment Variables (production), never in git.
# A channel appears on the site only when its provider is fully set; there is no fake "sent" without one.
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Optional: a separate secret for hashing codes (32+ characters); defaults to JWT_SECRET
OTP_HASH_SECRET=
# Email codes through Resend (https://resend.com): verify your sending domain there first
RESEND_API_KEY=
EMAIL_FROM=Arvixa Store <no-reply@your-verified-domain.in>
SUPPORT_EMAIL=
# SMS codes in India through MSG91 (https://msg91.com): needs DLT registration, an approved sender ID and an OTP
# template containing ##OTP##. Or set SMS_PROVIDER=twilio and use the TWILIO_* values above.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# WhatsApp codes through the WhatsApp Cloud API (Meta Business): a verified business, a phone number id and an
# approved AUTHENTICATION template with a copy-code button. Set WHATSAPP_TEMPLATE_BUTTON=false if yours has none.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Switch a configured channel off without deleting its keys
EMAIL_OTP_ENABLED=true
SMS_OTP_ENABLED=true
WHATSAPP_OTP_ENABLED=true
# Local development only (npm run local): codes appear on screen instead of being sent. Ignored in production builds.
OTP_DEV_CODES=

# ---------- CRM, notifications and public launch (api/_crm*.mjs, api/_messaging.mjs, api/_shipping.mjs) ----------
# Public address of the store: links in emails, unsubscribe links, webhook addresses
SITE_URL=https://arvixa-store.vercel.app
# Vercel Cron sends this to the daily CRM job (/api/crm/cron): automatic leads, automations, retries
CRON_SECRET=
# Email for order updates and campaigns: Resend (above) or SMTP. MARKETING_EMAIL_FROM is optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MARKETING_EMAIL_FROM=
# Resend → Webhooks → https://<site>/api/webhooks/resend (delivered / opened / clicked / bounced): its signing secret
RESEND_WEBHOOK_SECRET=
# SMS updates through MSG91: a DLT-approved flow template with one variable ##VAR1## (or use the TWILIO_* values)
MSG91_NOTIFY_TEMPLATE_ID=
# WhatsApp updates and campaigns need approved templates with one body variable each
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_MARKETING_TEMPLATE=
# Meta app → WhatsApp → Configuration: callback https://<site>/api/webhooks/whatsapp, this verify token, the app secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: a separate secret (32+ characters) for unsubscribe links; defaults to JWT_SECRET
UNSUBSCRIBE_SECRET=
# Courier (Shiprocket): API user, pickup pincode and pickup location name, and the tracking-webhook token
# (Shiprocket → Settings → API → Webhooks: https://<site>/api/webhooks/courier, header x-api-key = this token)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# ---------- Portals, MFA and payment mode ----------
# Online payments run in TEST mode unless this is set to live on purpose (after test-mode checks pass). The Razorpay
# key must match: rzp_test_… for test, rzp_live_… for live; a mismatch keeps online payment off.
PAYMENTS_MODE=test
# Optional: a separate secret (32+ characters) for encrypting admin MFA secrets; defaults to JWT_SECRET
MFA_ENCRYPTION_KEY=
