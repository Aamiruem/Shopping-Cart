PORT=5000
MONGO_URI=mongodb://localhost:27017/shop
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# Google sign-in (optional): OAuth client ID of type "Web application" from
# https://console.cloud.google.com/apis/credentials, with your site added to "Authorised JavaScript origins"
GOOGLE_CLIENT_ID=

# Email for payment OTPs (optional). Without SMTP_HOST, codes are printed to this server's console.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Veyra <no-reply@veyra.example>
OTP_TTL_MINUTES=5
