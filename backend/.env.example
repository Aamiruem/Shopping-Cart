# ---- Arvixa API (FastAPI) ----
APP_ENV=development
PORT=5000

# PostgreSQL: users, sellers, addresses, orders, support tickets (AWS: RDS for PostgreSQL)
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
# Set to 0 when connecting through PgBouncer / RDS Proxy
PG_STATEMENT_CACHE_SIZE=100

# MongoDB: products, carts, wishlists, behaviour events (AWS: DocumentDB or MongoDB Atlas)
# DocumentDB example: mongodb://user:pass@cluster.docdb.amazonaws.com:27017/shop?tls=true&tlsCAFile=global-bundle.pem&retryWrites=false
MONGO_URI=mongodb://localhost:27017/shop

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8100

# Google sign-in (optional): OAuth client ID of type "Web application" from
# https://console.cloud.google.com/apis/credentials, with your site in "Authorised JavaScript origins"
GOOGLE_CLIENT_ID=

# Email for payment OTPs (optional). Without SMTP_HOST, codes are printed to this server's console.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
# Amazon SES: SMTP_HOST=email-smtp.ap-south-1.amazonaws.com SMTP_PORT=587 + SES SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Arvixa <no-reply@arvixa.example>
OTP_TTL_MINUTES=5

# Online payments - Razorpay (RBI-authorised payment aggregator): UPI, net banking with all major banks, cards, wallets.
# 1. Sign up at https://dashboard.razorpay.com (test mode needs no KYC)  2. Settings -> API Keys -> generate test keys
# 3. Settings -> Webhooks -> add https://<your-domain>/api/payments/razorpay/webhook with events
#    payment.captured, payment.failed, refund.processed and copy its secret here.
# Without keys, checkout offers cash on delivery plus a demo OTP payment (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mobile OTP by SMS and WhatsApp - Twilio (https://console.twilio.com). Without these, development shows the code
# on screen. WhatsApp: start with the Twilio sandbox number (whatsapp:+14155238886), then an approved sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Encrypts seller bank account numbers at rest. REQUIRED in production. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Public storefront URL used in sitemap.xml and canonical links (e.g. https://www.yourstore.in)
SITE_URL=
# The built storefront's index.html (Docker: http://frontend/index.html). Product and category pages are then
# served with their title, description and link-preview card already in the HTML (Bing, WhatsApp, Facebook...)
FRONTEND_INDEX_URL=

# Product media (images, videos, audio): Amazon S3 when S3_BUCKET is set (credentials from the ECS task role /
# AWS profile), otherwise saved to backend/uploads/
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_URL=

# Analytics
TIMEZONE=Asia/Kolkata
ANALYTICS_CACHE_MINUTES=30
